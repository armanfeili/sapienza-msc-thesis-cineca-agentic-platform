    {
      "id": "graph.secure_query@1",
      "name": "graph.secure_query",
      "module": "src.mcp.tools.graph.secure_query",
      "description": "Safely answer user prompts over Memgraph: NL→Cypher, validate (read-only + safety + permissions), execute if allowed, return results.",
      "capabilities": [
        "reads_db",
        "nl_to_cypher",
        "policy_enforced"
      ],
      "scopes": [
        "tools:basic"
      ],
      "namespace": false,
      "long_running": false,
      "metadata": {
        "rate_limit_hint": "10/min per principal",
        "safety": {
          "write_operations": "blocked",
          "read_only_enforcement": true,
          "permission_checks": "required"
        }
      },
      "input_schema": {
        "type": "object",
        "required": [
          "action",
          "principal",
          "tenant"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "ask",
              "generate",
              "validate",
              "execute"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 3
          },
          "cypher": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "description": "Alias for cypher/query"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "principal": {
            "type": "string",
            "minLength": 1
          },
          "tenant": {
            "type": "string",
            "minLength": 1
          },
          "max_rows": {
            "type": "integer",
            "minimum": 1,
            "default": 1000
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "default": 5000
          },
          "return_format": {
            "type": "string",
            "enum": [
              "rows",
              "markdown",
              "csv",
              "json"
            ],
            "default": "rows"
          }
        },
        "additionalProperties": false
      }
    },
