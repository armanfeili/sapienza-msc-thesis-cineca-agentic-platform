#!/usr/bin/env bash
# examples/curl.http
#
# Handy curl snippets to exercise the Cineca Agentic Platform API.
# Copy/paste lines into your terminal, or run the whole file with:  bash examples/curl.http
# Requires: curl, jq
set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# Config
# ─────────────────────────────────────────────────────────────────────────────
: "${HOST:=http://localhost:8000}"
: "${USERNAME:=demo}"
: "${PASSWORD:=demo}"

echo "Using HOST=${HOST}"

# ─────────────────────────────────────────────────────────────────────────────
# Auth: login → tokens
# ─────────────────────────────────────────────────────────────────────────────
echo "Logging in as ${USERNAME}…"
LOGIN_JSON="$(curl -sS -X POST "${HOST}/v1/auth/login" \
  -H 'Content-Type: application/json' \
  -d "$(jq -n --arg u "$USERNAME" --arg p "$PASSWORD" '{username:$u, password:$p}')" )"

ACCESS_TOKEN="$(jq -r '.access_token' <<<"$LOGIN_JSON")"
REFRESH_TOKEN="$(jq -r '.refresh_token' <<<"$LOGIN_JSON")"

if [[ -z "${ACCESS_TOKEN}" || "${ACCESS_TOKEN}" == "null" ]]; then
  echo "ERROR: login failed. Response:"
  echo "$LOGIN_JSON" | jq .
  exit 1
fi

echo "Access token acquired."
echo "$LOGIN_JSON" | jq '{access_token:.access_token|.[0:24]+"…", refresh_token:.refresh_token|.[0:24]+"…", token_type, expires_in}'

AUTHZ="Authorization: Bearer ${ACCESS_TOKEN}"

# ─────────────────────────────────────────────────────────────────────────────
# Auth: whoami
# ─────────────────────────────────────────────────────────────────────────────
echo
echo "== /v1/auth/whoami =="
curl -sS -H "${AUTHZ}" "${HOST}/v1/auth/whoami" | jq .

# ─────────────────────────────────────────────────────────────────────────────
# Auth: refresh
# ─────────────────────────────────────────────────────────────────────────────
echo
echo "== /v1/auth/refresh =="
REFRESH_JSON="$(curl -sS -X POST "${HOST}/v1/auth/refresh" \
  -H 'Content-Type: application/json' \
  -d "$(jq -n --arg r "$REFRESH_TOKEN" '{refresh_token:$r}')" )"

NEW_ACCESS_TOKEN="$(jq -r '.access_token' <<<"$REFRESH_JSON")"
if [[ "$NEW_ACCESS_TOKEN" != "null" && -n "$NEW_ACCESS_TOKEN" ]]; then
  ACCESS_TOKEN="$NEW_ACCESS_TOKEN"
  AUTHZ="Authorization: Bearer ${ACCESS_TOKEN}"
  echo "Token refreshed."
else
  echo "Refresh failed or not supported; continuing with original token."
fi

# ─────────────────────────────────────────────────────────────────────────────
# Health & status
# ─────────────────────────────────────────────────────────────────────────────
echo
echo "== /v1/health/liveness =="
curl -sS "${HOST}/v1/health/liveness" | jq .

echo
echo "== /v1/health/readiness =="
curl -sS "${HOST}/v1/health/readiness" | jq .

echo
echo "== /v1/health/startup =="
curl -sS "${HOST}/v1/health/startup" | jq .

echo
echo "== /v1/status =="
curl -sS -H "${AUTHZ}" "${HOST}/v1/status" | jq .

# ─────────────────────────────────────────────────────────────────────────────
# OpenAPI
# ─────────────────────────────────────────────────────────────────────────────
echo
echo "== /openapi.json =="
curl -sS "${HOST}/openapi.json" | jq '.info, (.paths | keys | .[0:10])'

# ─────────────────────────────────────────────────────────────────────────────
# Models: list, active, (optional) select, test
# ─────────────────────────────────────────────────────────────────────────────
echo
echo "== GET /v1/models =="
curl -sS -H "${AUTHZ}" "${HOST}/v1/models" | jq .

echo
echo "== GET /v1/models/active =="
curl -sS -H "${AUTHZ}" "${HOST}/v1/models/active" | jq .

# Example select (uncomment and set a valid model id from /models):
# MODEL_ID="gpt-4o-mini"
# echo
# echo "== POST /models/select =="
# curl -sS -X POST -H "${AUTHZ}" -H 'Content-Type: application/json' \
#   -d "$(jq -n --arg id "$MODEL_ID" '{model_id:$id}')" \
#   "${HOST}/models/select" | jq .

echo
echo "== POST /v1/models/test =="
curl -sS -X POST -H "${AUTHZ}" -H 'Content-Type: application/json' \
  -d '{"prompt":"Say hello in one short sentence."}' \
  "${HOST}/v1/models/test" | jq .

# ─────────────────────────────────────────────────────────────────────────────
# Agent: simple run
# ─────────────────────────────────────────────────────────────────────────────
echo
echo "== POST /v1/agents:run =="
curl -sS -X POST -H "${AUTHZ}" -H 'Content-Type: application/json' \
  -d "$(jq -n '{input:{prompt:"List three graph database use-cases."}}')" \
  "${HOST}/v1/agents:run" | jq .

# ─────────────────────────────────────────────────────────────────────────────
# Tools: list & invoke (using example payloads)
# ─────────────────────────────────────────────────────────────────────────────
EX_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/tools"

echo
echo "== GET /v1/tools =="
curl -sS -H "${AUTHZ}" "${HOST}/v1/tools" | jq .

echo
echo "== POST /tools/query  (examples/tools/query_read.json) =="
curl -sS -X POST -H "${AUTHZ}" -H 'Content-Type: application/json' \
  --data "@${EX_DIR}/query_read.json" \
  "${HOST}/v1/tools/query" | jq .

echo
echo "== POST /tools/generate_cypher  (examples/tools/generate_cypher.json) =="
curl -sS -X POST -H "${AUTHZ}" -H 'Content-Type: application/json' \
  --data "@${EX_DIR}/generate_cypher.json" \
  "${HOST}/v1/tools/generate_cypher" | jq .

echo
echo "== POST /tools/crud/create  (examples/tools/crud_create_node.json) =="
curl -sS -X POST -H "${AUTHZ}" -H 'Content-Type: application/json' \
  --data "@${EX_DIR}/crud_create_node.json" \
  "${HOST}/v1/tools/crud/create" | jq .

echo
echo "== POST /tools/schema/discover  (examples/tools/schema_discover.json) =="
curl -sS -X POST -H "${AUTHZ}" -H 'Content-Type: application/json' \
  --data "@${EX_DIR}/schema_discover.json" \
  "${HOST}/v1/tools/schema/discover" | jq .

echo
echo "== POST /tools/search/semantic  (examples/tools/search_semantic.json) =="
curl -sS -X POST -H "${AUTHZ}" -H 'Content-Type: application/json' \
  --data "@${EX_DIR}/search_semantic.json" \
  "${HOST}/v1/tools/search/semantic" | jq .

echo
echo "== POST /tools/system/health  (examples/tools/system_health.json) =="
curl -sS -X POST -H "${AUTHZ}" -H 'Content-Type: application/json' \
  --data "@${EX_DIR}/system_health.json" \
  "${HOST}/v1/tools/system/health" | jq .

# ─────────────────────────────────────────────────────────────────────────────
# Cache & session (if enabled by the deployment)
# ─────────────────────────────────────────────────────────────────────────────
echo
echo "== (Optional) GET /session =="
if curl -fsS -H "${AUTHZ}" "${HOST}/v1/session" >/dev/null 2>&1; then
  curl -sS -H "${AUTHZ}" "${HOST}/v1/session" | jq .
else
  echo "Endpoint not available; skipping."
fi

# ─────────────────────────────────────────────────────────────────────────────
# Done
# ─────────────────────────────────────────────────────────────────────────────
echo
echo "All curl requests completed successfully."
