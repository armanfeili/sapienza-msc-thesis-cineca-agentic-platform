@host = http://localhost:8000
@username = demo
@password = demo

### Obtain JWT tokens (access + refresh)
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###

# Extract tokens from the previous response (REST Client variable captures)
@token = {{login.response.body.$.access_token}}
@refresh_token = {{login.response.body.$.refresh_token}}

### Inspect current identity
GET {{host}}/auth/whoami
Authorization: Bearer {{token}}

###

### Refresh the access token
# @name refresh
POST {{host}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

###

# Update @token to the new access token returned by refresh
@token = {{refresh.response.body.$.access_token}}

### Verify the new token works
GET {{host}}/auth/whoami
Authorization: Bearer {{token}}

###

### (Optional) Logout / revoke the current token(s)
# Some deployments may ignore this endpoint if stateless.
POST {{host}}/auth/logout
Authorization: Bearer {{token}}

###

### (Negative test) Wrong password should return 401
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "incorrect-password"
}
