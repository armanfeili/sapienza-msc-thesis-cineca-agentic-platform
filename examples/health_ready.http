# examples/health_ready.http
#
# Use with VS Code "REST Client" or IntelliJ HTTP client.
# Set environment variables in the top-level .env or here inline.

@host = http://localhost:8000
@apikey = {{$dotenv API_KEY}}
@token = {{$dotenv ACCESS_TOKEN}}

### Liveness probe (fast, minimal dependencies)
GET {{host}}/health/liveness
Accept: application/json

### Readiness probe (checks downstream dependencies like DB/Redis/LLM)
GET {{host}}/health/readiness
Accept: application/json

### Startup probe (one-time heavy initialization)
GET {{host}}/health/startup
Accept: application/json

### System status (may require auth depending on deployment)
GET {{host}}/status
Accept: application/json
X-API-Key: {{apikey}}
Authorization: Bearer {{token}}

### Prometheus metrics (text/plain; scrape endpoint)
GET {{host}}/metrics
Accept: text/plain

### Optional: echo server time (if implemented)
GET {{host}}/health/time
Accept: application/json

###
# cURL equivalents (copy and run in a shell)
# export BASE_URL="http://localhost:8000"
# curl -s "$BASE_URL/health/liveness" | jq
# curl -s "$BASE_URL/health/readiness" | jq
# curl -s "$BASE_URL/health/startup" | jq
# curl -s -H "X-API-Key: $API_KEY" -H "Authorization: Bearer $ACCESS_TOKEN" "$BASE_URL/status" | jq
# curl -s "$BASE_URL/metrics" | head -50
