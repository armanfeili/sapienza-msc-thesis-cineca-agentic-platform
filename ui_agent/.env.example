# Backend API URL (Docker Compose exposes app on port 8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Auth0 JWT Tokens (required for authentication with the backend)
# Get these from the main project .env file after running fetch_auth0_tokens.sh
# 
# Admin token has scopes: user:me, tools:invoke:all, admin:all
AUTH0_ADMIN_TOKEN=your_admin_jwt_token_here

# User token has scopes: user:me, tools:invoke:basic
AUTH0_USER_TOKEN=your_user_jwt_token_here
