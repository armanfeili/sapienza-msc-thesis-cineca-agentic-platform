{
  "dashboard": {
    "title": "Agent Run Orchestration",
    "tags": ["agent", "orchestration", "llm"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Agent Run Duration (Percentiles)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(agent_run_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(agent_run_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(agent_run_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration",
            "show": true
          },
          {
            "show": false
          }
        ],
        "tooltip": {"shared": true}
      },
      {
        "id": 2,
        "title": "Agent Run Status Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum by (status) (increase(agent_run_duration_seconds_count[1h]))",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Agent Run Failure Rate by Type",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum by (failure_type) (rate(agent_run_failures_total[5m]))",
            "legendFormat": "{{failure_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Failures/sec",
            "show": true
          },
          {
            "show": false
          }
        ],
        "tooltip": {"shared": true}
      },
      {
        "id": 4,
        "title": "Active Agent Runs",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "agent_runs_queued",
            "legendFormat": "Queued",
            "refId": "A"
          },
          {
            "expr": "agent_runs_running",
            "legendFormat": "Running",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Count",
            "show": true
          },
          {
            "show": false
          }
        ],
        "tooltip": {"shared": true}
      },
      {
        "id": 5,
        "title": "TODO Execution Metrics",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "rate(agent_todos_count[5m])",
            "legendFormat": "TODOs/sec",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(agent_todo_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "TODO Duration p95",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Rate / Duration",
            "show": true
          },
          {
            "show": false
          }
        ],
        "tooltip": {"shared": true}
      },
      {
        "id": 6,
        "title": "Step Execution Metrics",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "rate(agent_steps_count[5m])",
            "legendFormat": "Steps/sec",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(agent_step_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "Step Duration p95",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Rate / Duration",
            "show": true
          },
          {
            "show": false
          }
        ],
        "tooltip": {"shared": true}
      },
      {
        "id": 7,
        "title": "Model Warmup Duration",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "agent_warmup_duration_seconds",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "background",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 60, "color": "yellow"},
                {"value": 120, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Total Failures (Last Hour)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 24},
        "targets": [
          {
            "expr": "sum(increase(agent_run_failures_total[1h]))",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "background",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Average Run Duration (5m)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "sum(rate(agent_run_duration_seconds_sum[5m])) / sum(rate(agent_run_duration_seconds_count[5m]))",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 180, "color": "yellow"},
                {"value": 300, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Success Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 24},
        "targets": [
          {
            "expr": "sum(rate(agent_run_duration_seconds_count{status=\"succeeded\"}[5m])) / sum(rate(agent_run_duration_seconds_count[5m])) * 100",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "background",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 80, "color": "yellow"},
                {"value": 95, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Timeout Breakdown",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "sum by (failure_type) (increase(agent_run_failures_total{failure_type=~\".*timeout\"}[1h]))",
            "legendFormat": "{{failure_type}}",
            "refId": "A"
          }
        ],
        "options": {
          "displayMode": "gradient",
          "orientation": "horizontal",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 20, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "title": "Run Duration by Tenant",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (tenant_id, le) (rate(agent_run_duration_seconds_bucket[5m])))",
            "legendFormat": "{{tenant_id}} p95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration",
            "show": true
          },
          {
            "show": false
          }
        ],
        "tooltip": {"shared": true}
      }
    ]
  }
}
