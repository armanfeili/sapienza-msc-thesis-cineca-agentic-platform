######################################################################
#  .env  – CONSOLIDATED runtime configuration
#  DO NOT COMMIT THIS FILE - Contains sensitive credentials
######################################################################

# ── PostgreSQL connection ───────────────────────────────────────────
DB_HOST=postgres         # must match the service name in docker-compose.yml
DB_PORT=5432            # PostgreSQL default port
DB_NAME=cineca_platform # database name
DB_USER=cineca_user     # database user
DB_PASSWORD=change_me_now  # CHANGE IN PRODUCTION!
DB_SSLMODE=disable      # disable for local dev; use 'require' or 'verify-full' in production
DB_POOL_SIZE=10         # connection pool size
DB_POOL_TIMEOUT=30      # pool timeout in seconds

# ── Memgraph connection (used by db-populate / api / agent) ─────────
MG_HOST=memgraph        # must match the service name in docker-compose.yml
MG_PORT=7687            # Bolt port exposed by the Memgraph container
# MG_TLS=false          # set to true if you enable TLS on Memgraph

# ── Uncomment the next two lines if you enable auth in Memgraph ─────
# MG_USER=memgraph_user
# MG_PASSWORD=change_me_now

######################################################################
#  Application runtime
######################################################################
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO           # DEBUG, INFO, WARNING, ERROR, CRITICAL
ENABLE_DOCS=true         # serve /docs and /openapi.json in non-prod

# CORS (comma-separated lists)
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type

######################################################################
#  Security / Auth
######################################################################
# Replace before deploying to production
JWT_SECRET=change_me_now_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Request validation / guardrails (optional toggles)
INTENT_FILTER_ENABLED=true
OUTPUT_GUARD_ENABLED=true
PII_SCRUBBING_ENABLED=true

# OpenID Connect / Auth0 configuration
OIDC_ISSUER=https://cineca.eu.auth0.com/
OIDC_AUDIENCE=api://cineca-agentic-platform
OIDC_JWKS_URL=https://cineca.eu.auth0.com/.well-known/jwks.json

# Auth0 Client Credentials
AUTH0_DOMAIN=cineca.eu.auth0.com
AUTH0_AUDIENCE=api://cineca-agentic-platform
AUTH0_REALM=Username-Password-Authentication

# User Client (Password Realm Grant)
AUTH0_USER_CLIENT_ID=kwkf1bGn2NmdKWzioZYkvtYM022dzb5C
AUTH0_USER_CLIENT_SECRET=z8Qf1DeYl-6fDKlGn5tpOuAshkjhiJmNrYkPibfBoR5vA5VC_7qznoavBN0rSZEB

