# Comma-separated list of tool IDs considered "safe" (callable by non-admin users)
SAFE_TOOLS=system.health,system.status,system.metrics,graph.schema,graph.search

######################################################################
#  Cache & Rate Limiting
######################################################################
RATE_LIMIT_BACKEND=redis      # memory | redis
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_WINDOW_SECONDS=60  # sliding window size
RATE_LIMIT_MAX_REQUESTS=100   # requests allowed per window per identity

# Test mode settings (from .env.test)
RATE_LIMIT_MODE=test          # prod | test (use 'prod' in production!)
DEMO_MODE=true

######################################################################
#  Observability (Prometheus / OTEL)
######################################################################
PROMETHEUS_METRICS_ENABLED=true
OTEL_SERVICE_NAME=cineca-agentic-platform
# If you have an OTLP collector, set the endpoint below (grpc or http/proto)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=${APP_ENV}

######################################################################
#  LLM / Model adapter - Hybrid Role-Based Setup with Ollama
######################################################################
# Main LLM: Mistral 7B (Planner/Manager/Finalizer) - Best reasoning
DEFAULT_MODEL=mistral:7b-instruct
LLM_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_TIMEOUT_SECS=1800

LLM_SMOKE_TIMEOUT_SECONDS=600
LLM_CLIENT_TIMEOUT_SECONDS=720

# Orchestrator Timeouts (increased for CPU execution)
# Uncomment to override defaults (12 minutes for CPU execution)
# LLM_RUN_TIMEOUT_SECONDS=1800

# Role-based LLM clients (hybrid setup)
# Planner/Manager: mistral-7b (7.2B params - best reasoning)
# Workers: phi3-mini-instruct (3.8B params - fast execution)
# Fallbacks: llama3.2 (long context), qwen2.5 (strict JSON)
LLM_CLIENTS=planner=http://ollama:11434,workerA=http://ollama:11434,workerB=http://ollama:11434

# Model warmup configuration
LLM_WARMUP_ENABLED=true
LLM_WARMUP_TIMEOUT=1800

######################################################################
#  Internationalization & data generation (optional)
######################################################################
DEFAULT_LOCALE=en
FAKER_LOCALE=en_US

######################################################################
#  Background jobs / scheduler
######################################################################
SCHEDULER_ENABLED=true
ENABLE_SCHEDULER=false        # Override for tests
SCHEDULED_HEALTHCHECK_INTERVAL_SECONDS=60
SCHEDULED_CLEANUP_INTERVAL_SECONDS=3600

# Job storage backend (memory for legacy, redis for persistence)
JOB_STORE_BACKEND=redis
# PostgreSQL backend for jobs (requires Alembic migrations)
# Set to true to use PostgreSQL + Redis for jobs API
USE_POSTGRES_JOBS=true

######################################################################
#  Service limits & safety rails (optional)
######################################################################
MAX_GRAPH_RESULT_NODES=1000
MAX_GRAPH_RESULT_EDGES=2000
MAX_QUERY_COST=10000

######################################################################
#  Data retention (optional)
######################################################################
RETENTION_DAYS=30

