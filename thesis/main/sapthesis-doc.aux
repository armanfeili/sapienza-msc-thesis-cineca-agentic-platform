\@writefile{lof}{\contentsline {figure}{\numberline {C.1}{\ignorespaces Unified lifecycle state machine for agent runs (FR-AE-01, EC-FC-01) and jobs (FR-JB-02, EC-FC-07). Labels before the slash apply to agent runs; labels after the slash apply to jobs. Double-bordered states are terminal. For jobs, cancellation is cooperative: the worker checks a cancellation flag between steps.}}{94}{figure.caption.118}\protected@file@percent }
\newlabel{fig:lifecycle-sm}{{C.1}{94}{Unified lifecycle state machine for agent runs (FR-AE-01, EC-FC-01) and jobs (FR-JB-02, EC-FC-07). Labels before the slash apply to agent runs; labels after the slash apply to jobs. Double-bordered states are terminal. For jobs, cancellation is cooperative: the worker checks a cancellation flag between steps}{figure.caption.118}{}}
\newlabel{fig:run-sm}{{C.1}{94}{Unified lifecycle state machine for agent runs (FR-AE-01, EC-FC-01) and jobs (FR-JB-02, EC-FC-07). Labels before the slash apply to agent runs; labels after the slash apply to jobs. Double-bordered states are terminal. For jobs, cancellation is cooperative: the worker checks a cancellation flag between steps}{figure.caption.118}{}}
\newlabel{fig:job-sm}{{C.1}{94}{Unified lifecycle state machine for agent runs (FR-AE-01, EC-FC-01) and jobs (FR-JB-02, EC-FC-07). Labels before the slash apply to agent runs; labels after the slash apply to jobs. Double-bordered states are terminal. For jobs, cancellation is cooperative: the worker checks a cancellation flag between steps}{figure.caption.118}{}}
