        \node[container, fill=cyan!20] (mg) at (1.5, -1.5) {Memgraph};
        \node[container, fill=gray!20] (prom) at (4, -1.5) {Prometheus};
        
        % Arrows
        \draw[arrow] (nginx) -- (api1);
        \draw[arrow] (nginx) -- (api2);
        \draw[arrow] (nginx) -- (ui);
        \draw[arrow] (api1) -- (pg);
