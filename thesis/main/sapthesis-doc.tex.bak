        \toprule
        \textbf{Entity} & \textbf{States} & \textbf{Terminal States} \\
        \midrule
        Agent Run & queued $\to$ planning $\to$ running & succeeded, failed, cancelled \\
        Job & queued $\to$ running & finished, failed, cancelled \\
