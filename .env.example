######################################################################
#  .env.example - Template for runtime configuration
#  Copy this file to .env and fill in YOUR values.
#  DO NOT COMMIT .env to Git - it contains sensitive credentials.
######################################################################

# -- PostgreSQL connection -------------------------------------------
DB_HOST=postgres              # Service name in docker-compose.yml (or localhost for local dev)
DB_PORT=5432                  # PostgreSQL default port
DB_NAME=cineca_platform       # Database name
DB_USER=cineca_user           # Database user
DB_PASSWORD=change_me_now     # CHANGE IN PRODUCTION!
DB_SSLMODE=disable            # Use 'require' or 'verify-full' in production
DB_POOL_SIZE=10               # Connection pool size
DB_POOL_TIMEOUT=30            # Pool timeout in seconds

# -- Memgraph connection ---------------------------------------------
MG_HOST=memgraph              # Service name in docker-compose.yml (or localhost for local dev)
MG_PORT=7687                  # Bolt port exposed by the Memgraph container
# MG_TLS=false                # Set to true if you enable TLS on Memgraph
# MG_USER=memgraph_user       # Uncomment if auth is enabled
# MG_PASSWORD=change_me_now   # Uncomment if auth is enabled

######################################################################
#  Application runtime
######################################################################
APP_ENV=dev                   # dev | test | prod
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR, CRITICAL
ENABLE_DOCS=true              # Serve /docs and /openapi.json (disable in prod)

# CORS (comma-separated lists)
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type

######################################################################
#  Security / Auth
######################################################################
# Replace before deploying to production
JWT_SECRET=change_me_now_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Request validation / guardrails
INTENT_FILTER_ENABLED=true
OUTPUT_GUARD_ENABLED=true
PII_SCRUBBING_ENABLED=true

# OpenID Connect / Auth0 configuration
OIDC_ISSUER=https://your-tenant.auth0.com/
OIDC_AUDIENCE=api://your-api-identifier
OIDC_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json

# Auth0 Client Credentials
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=api://your-api-identifier
AUTH0_REALM=Username-Password-Authentication

# User Client (Password Realm Grant)
AUTH0_USER_CLIENT_ID=your-user-client-id
AUTH0_USER_CLIENT_SECRET=your-user-client-secret

# Aliases for docker-compose / testing
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Machine Client (Client Credentials Grant)
AUTH0_MACHINE_CLIENT_ID=your-machine-client-id
AUTH0_MACHINE_CLIENT_SECRET=your-machine-client-secret

# Test User Credentials (for Password Realm Grant)
AUTH0_ADMIN_USERNAME=admin@example.com
AUTH0_ADMIN_PASSWORD=AdminPass123!
AUTH0_USER_USERNAME=user@example.com
AUTH0_USER_PASSWORD=UserPass123!

# Admin/User Scopes
ADMIN_SCOPE=user:me tools:invoke:all admin:all
USER_SCOPE=user:me tools:invoke:basic

# Fetched tokens (populated by scripts/fetch_auth0_tokens.sh)
# ADMIN_TOKEN=eyJ...
# USER_TOKEN=eyJ...
# AUTH0_ADMIN_TOKEN=eyJ...
# AUTH0_USER_TOKEN=eyJ...
# AUTH0_MACHINE_TOKEN=eyJ...

# Comma-separated list of tool IDs considered "safe" (callable by non-admin users)
SAFE_TOOLS=system.health,system.status,system.metrics,graph.schema,graph.search

######################################################################
#  Cache & Rate Limiting
######################################################################
RATE_LIMIT_BACKEND=redis          # memory | redis
REDIS_URL=redis://redis:6379/0    # Use redis://localhost:6379/0 for local dev
RATE_LIMIT_WINDOW_SECONDS=60      # Sliding window size
RATE_LIMIT_MAX_REQUESTS=100       # Requests allowed per window per identity
RATE_LIMIT_MODE=prod              # prod | test (use 'prod' in production!)
DEMO_MODE=false                   # Set to true only for demos

######################################################################
#  Observability (Prometheus / OTEL)
######################################################################
PROMETHEUS_METRICS_ENABLED=true
OTEL_SERVICE_NAME=cineca-agentic-platform
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=${APP_ENV}

######################################################################
#  LLM / Model adapter
######################################################################
# Main LLM configuration
DEFAULT_MODEL=mistral:7b-instruct
LLM_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_TIMEOUT_SECS=1800

# LLM Timeouts
LLM_SMOKE_TIMEOUT_SECONDS=600
LLM_CLIENT_TIMEOUT_SECONDS=720
# LLM_RUN_TIMEOUT_SECONDS=1800    # Uncomment for CPU execution

# Role-based LLM clients (optional)
# LLM_CLIENTS=planner=http://ollama:11434,workerA=http://ollama:11434

# Model warmup
LLM_WARMUP_ENABLED=true
LLM_WARMUP_TIMEOUT=1800

######################################################################
#  Internationalization & data generation
######################################################################
DEFAULT_LOCALE=en
FAKER_LOCALE=en_US

######################################################################
#  Background jobs / scheduler
######################################################################
SCHEDULER_ENABLED=true
ENABLE_SCHEDULER=false            # Override for tests
SCHEDULED_HEALTHCHECK_INTERVAL_SECONDS=60
SCHEDULED_CLEANUP_INTERVAL_SECONDS=3600

# Job storage backend
JOB_STORE_BACKEND=redis           # memory | redis
USE_POSTGRES_JOBS=true            # Use PostgreSQL + Redis for jobs API

######################################################################
#  Service limits & safety rails
######################################################################
MAX_GRAPH_RESULT_NODES=1000
MAX_GRAPH_RESULT_EDGES=2000
MAX_QUERY_COST=10000

######################################################################
#  Data retention
######################################################################
RETENTION_DAYS=30

######################################################################
#  NOTES FOR PRODUCTION
######################################################################
# DO NOT:
#  - Commit .env with secrets to Git
#  - Hardcode tokens or passwords
#  - Use RATE_LIMIT_MODE=test in production
#  - Set LOG_LEVEL=DEBUG in production (too verbose)
#
# DO:
#  - Use environment variables from a secure vault
#  - Rotate tokens regularly
#  - Use DB_SSLMODE=require or verify-full
#  - Monitor health endpoints
#
# For token management:
#   ./fetch_auth0_tokens.sh --save-to-env
