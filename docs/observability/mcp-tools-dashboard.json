{
  "title": "MCP Tools Observability",
  "dashboard": {
    "id": null,
    "uid": "mcp-tools",
    "title": "MCP Tools Observability",
    "tags": ["mcp", "observability", "tools"],
    "timezone": "browser",
    "schemaVersion": 37,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "type": "stat",
        "title": "Total MCP Requests",
        "id": 1,
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(mcp_requests_total)",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "orientation": "horizontal",
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center"
        }
      },
      {
        "type": "timeseries",
        "title": "MCP Request Rate (RPS)",
        "id": 2,
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(mcp_requests_total[1m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "req/s"
          }
        }
      },
      {
        "type": "timeseries",
        "title": "MCP Error Rate (%)",
        "id": 3,
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "(sum(rate(mcp_requests_total{status=\"error\"}[5m])) / sum(rate(mcp_requests_total[5m]))) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "type": "timeseries",
        "title": "MCP Query Execution Time (p95)",
        "id": 4,
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(mcp_query_duration_seconds_bucket[5m])) by (le))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "type": "timeseries",
        "title": "MCP Tool Calls by Tool",
        "id": 5,
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(mcp_tool_invocations_total[5m])) by (tool)",
            "refId": "A"
          }
        ],
        "legend": {
          "show": true
        }
      },
      {
        "type": "timeseries",
        "title": "MCP Tool Failures by Tool",
        "id": 6,
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(mcp_tool_invocations_total{status=\"error\"}[5m])) by (tool)",
            "refId": "A"
          }
        ],
        "legend": {
          "show": true
        }
      },
      {
        "type": "stat",
        "title": "Current Active MCP Sessions",
        "id": 7,
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(mcp_active_sessions)",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Memgraph Queries per Second",
        "id": 8,
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(memgraph_queries_executed_total[1m]))",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Memgraph Query Error Rate (%)",
        "id": 9,
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "(sum(rate(memgraph_queries_failed_total[5m])) / sum(rate(memgraph_queries_executed_total[5m]))) * 100",
            "refId": "A"
          }
        ]
      },
      {
        "type": "gauge",
        "title": "Memgraph Memory Usage (bytes)",
        "id": 10,
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "memgraph_memory_usage_bytes",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "tool",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(mcp_tool_invocations_total, tool)",
          "refresh": 1
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  },
  "overwrite": true
}
